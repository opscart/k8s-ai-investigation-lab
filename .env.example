# Copy to .env, edit, then: set -a; source .env; set +a
# Use the Foundry PROJECT endpoint, not the Azure OpenAI resource endpoint.
AZURE_AI_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_MODEL_DEPLOYMENT_NAME=YOUR-DEPLOYMENT-NAME
# Authentication uses your existing az login session; no API key is required.
